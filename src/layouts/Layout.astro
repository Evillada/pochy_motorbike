---
import '../styles/globals.css';
import { LANGS, OG_LOCALES, langPath, DEFAULT_LANG, type Lang } from '@/i18n/translations';
import { buildLocalBusinessJsonLd, serializeJsonLd } from '@/lib/structuredData';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

// Astro.site is only missing in dev — `astro build` refuses to run without it (see astro.config.mjs).
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pageUrl = absolute(langPath(lang));
const ogImage = absolute('/images/og-image.jpg');
const jsonLd = serializeJsonLd(
  buildLocalBusinessJsonLd({ pageUrl, imageUrl: ogImage, description, langCode: lang }),
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    {LANGS.map((code) => <link rel="alternate" hreflang={code} href={absolute(langPath(code))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(langPath(DEFAULT_LANG))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pochy Motorbike" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pochy Motorbike" />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {
      LANGS.filter((code) => code !== lang).map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-body">
    <slot />
    <script>
      if (matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (event) => {
            const card = (event.target as Element | null)?.closest?.<HTMLElement>('.card-surface');
            if (!card) return;
            const bounds = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${event.clientX - bounds.left}px`);
            card.style.setProperty('--my', `${event.clientY - bounds.top}px`);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
