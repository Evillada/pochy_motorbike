---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Financing from '../components/Financing.astro';
import WhyUs from '../components/WhyUs.astro';
import LocationHours from '../components/LocationHours.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { translations } from '@/i18n/translations';

// Server-rendered in Spanish by default, matching getServerLang() elsewhere.
const title = translations.es.meta.title;
const description = translations.es.meta.description;
---

<Layout title={title} description={description}>
  <Header />
  <main class="min-h-screen overflow-x-hidden">
    <Hero />
    <Services />
    <Financing />
    <WhyUs />
    <LocationHours />
    <FinalCta />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
